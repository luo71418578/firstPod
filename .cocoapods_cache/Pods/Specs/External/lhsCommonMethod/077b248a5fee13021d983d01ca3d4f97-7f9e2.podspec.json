{
  "name": "lhsCommonMethod",
  "version": "0.0.9",
  "summary": "A common utility library for iOS projects",
  "description": "lhsCommonMethod is a common utility library providing tools for permissions,\nnetwork reachability, toast notifications, color utilities, and more.",
  "homepage": "https://github.com/luo71418578/firstPod",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "luo71418578": "luo71418578@example.com"
  },
  "source": {
    "git": "https://github.com/luo71418578/firstPod.git",
    "tag": "0.0.9"
  },
  "platforms": {
    "ios": "13.0"
  },
  "frameworks": [
    "UIKit",
    "Foundation",
    "AVFoundation",
    "WebKit",
    "CoreTelephony"
  ],
  "requires_arc": true,
  "source_files": "lhsCommonMethod/*.{h,m}",
  "subspecs": [
    {
      "name": "Category",
      "source_files": "lhsCommonMethod/Category/*.{h,m}"
    },
    {
      "name": "CMMThirdPart",
      "source_files": "lhsCommonMethod/thirdPart/CMMThirdPart.{h,m}",
      "dependencies": {
        "lhsCommonMethod/LBXPermissions": [],
        "lhsCommonMethod/Toast": []
      }
    },
    {
      "name": "CountdownTimer",
      "source_files": "lhsCommonMethod/thirdPart/CountdownTimer/*.{h,m}"
    },
    {
      "name": "CutDownButton",
      "source_files": "lhsCommonMethod/thirdPart/CutDownButton/*.{h,m}"
    },
    {
      "name": "DocumentPickerManager",
      "source_files": "lhsCommonMethod/thirdPart/DocumentPickerManager/*.{h,m}"
    },
    {
      "name": "HexColors",
      "source_files": "lhsCommonMethod/thirdPart/HexColors/*.{h,m}"
    },
    {
      "name": "LBXPermissions",
      "source_files": "lhsCommonMethod/thirdPart/LBXPermissions/*.{h,m}"
    },
    {
      "name": "MMLocationManager",
      "source_files": "lhsCommonMethod/thirdPart/MMLocationManager/*.{h,m}",
      "dependencies": {
        "lhsCommonMethod/CMMThirdPart": []
      }
    },
    {
      "name": "Toast",
      "source_files": "lhsCommonMethod/thirdPart/Toast/*.{h,m}"
    }
  ]
}
